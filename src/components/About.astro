---
import { siteConfig } from "../config";
---

<section id="about" class="px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
    <div class="lg:col-span-4 reveal">
      <p class="font-mono text-sm accent">About</p>
      <h2 class="mt-2 text-4xl sm:text-5xl xl:text-6xl font-semibold tracking-tight text-gray-900">
        Commercial, and I build
      </h2>
    </div>
    <div class="lg:col-span-8 reveal">
      <p class="text-xl sm:text-2xl leading-relaxed text-gray-700">{siteConfig.aboutMe}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        {
          siteConfig.skills.map((s) => (
            <span class="px-3.5 py-1.5 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-gray-900 hover:text-gray-900 transition-colors">
              {s}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
