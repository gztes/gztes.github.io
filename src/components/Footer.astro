---
import { siteConfig } from "../config";
const s = siteConfig.social;
---

<footer class="px-6 sm:px-12 md:px-16 lg:px-24 py-10 border-t border-gray-100">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm text-gray-500">
    <p>© {new Date().getFullYear()} {siteConfig.name}</p>
    <div class="flex gap-6">
      <a class="hover:text-gray-900" href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="hover:text-gray-900" href={s.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="hover:text-gray-900" href={s.twitter} target="_blank" rel="noopener noreferrer">X</a>
      <a class="hover:text-gray-900" href="#hero">Back to top ↑</a>
    </div>
  </div>
</footer>
