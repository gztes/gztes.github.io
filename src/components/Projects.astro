---
import { siteConfig } from "../config";
const projects = siteConfig.projects ?? [];
const filters = ["All", ...new Set(projects.flatMap((p) => p.category ?? []))];
// bento: the lead project takes the wide slot, the rest fill a row of three
const span = (i: number) => (i === 0 ? "md:col-span-2" : "md:col-span-1");
---

{
  projects.length > 0 && (
    <section id="projects" class="px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
        <div>
          <p class="font-mono text-sm accent">Selected work</p>
          <h2 class="mt-2 text-4xl sm:text-5xl xl:text-6xl font-semibold tracking-tight text-gray-900">
            Things I've shipped
          </h2>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter={f}
              aria-pressed={i === 0 ? "true" : "false"}
              class="chip px-4 py-2 rounded-full text-sm font-medium border border-gray-300 text-gray-700 hover:border-gray-900 transition-colors"
            >
              {f}
            </button>
          ))}
        </div>
      </div>

      <div id="grid" class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        {projects.map((p, i) => (
          <a
            href={p.link}
            id={p.name.toLowerCase().split(" ")[0]}
            target="_blank"
            rel="noopener noreferrer"
            data-cats={(p.category ?? []).join(",")}
            class={`card group relative flex flex-col rounded-3xl border border-gray-200 bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gray-900/10 hover:border-gray-300 reveal ${span(i)}`}
          >
            {p.image && (
              <div class="overflow-hidden bg-gray-100 aspect-[16/9]">
                <img
                  src={p.image}
                  alt={`${p.name} screenshot`}
                  loading="lazy"
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
                />
              </div>
            )}
            {p.terminal && (
              <pre class="bg-gray-950 text-gray-300 text-[11px] sm:text-[13px] leading-relaxed p-5 sm:p-7 font-mono whitespace-pre-wrap overflow-hidden">{p.terminal}</pre>
            )}
            {!p.image && !p.terminal && (
              <div class="aspect-[16/9] md:aspect-auto md:flex-1 min-h-40 bg-gradient-to-br from-gray-900 to-gray-700 p-6 flex items-end">
                <span class="font-mono text-gray-300 text-sm">{p.name}.py · evals</span>
              </div>
            )}
            <div class="p-6 sm:p-7 flex flex-col gap-3 flex-1">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl sm:text-2xl font-semibold text-gray-900">{p.name}</h3>
                <span class="shrink-0 w-9 h-9 grid place-items-center rounded-full bg-gray-900 text-white transition-transform duration-300 group-hover:rotate-45" aria-hidden="true">↗</span>
              </div>
              <p class="text-gray-600 leading-relaxed">{p.description}</p>
              <div class="mt-auto pt-2 flex flex-wrap gap-1.5">
                {p.skills.map((s) => (
                  <span class="px-2.5 py-1 rounded-md bg-gray-100 text-gray-700 text-xs font-medium">{s}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const cards = document.querySelectorAll<HTMLElement>("#grid .card");
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      const f = c.dataset.filter!;
      chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
      cards.forEach((card) => {
        const show = f === "All" || card.dataset.cats!.split(",").includes(f);
        card.classList.toggle("hidden", !show);
        card.classList.toggle("md:col-span-2", false);
        card.classList.toggle("md:col-span-1", true);
      });
      if (f === "All") {
        cards.forEach((card, i) => {
          if (i === 0) {
            card.classList.remove("md:col-span-1");
            card.classList.add("md:col-span-2");
          }
        });
      }
    })
  );
</script>

<style>
  .chip[aria-pressed="true"] {
    background: #111827;
    color: #fff;
    border-color: #111827;
  }
</style>
