---
import { siteConfig } from "../config";
---

<section class="px-6 sm:px-12 md:px-16 lg:px-24" aria-label="In numbers">
  <div class="grid grid-cols-2 lg:grid-cols-4 rounded-3xl border border-gray-200 bg-gray-50/60 divide-x divide-y lg:divide-y-0 divide-gray-200 overflow-hidden reveal">
    {
      siteConfig.stats.map((st) => (
        <div class="p-6 sm:p-8">
          <p class="text-3xl sm:text-5xl font-semibold tracking-tight text-gray-900 tabular-nums">
            {st.prefix ?? ""}<span class="count" data-to={st.value} data-dec={st.decimals}>{st.value.toFixed(st.decimals)}</span>{st.suffix}
          </p>
          <p class="mt-2 text-sm text-gray-500 leading-snug">{st.label}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nums = document.querySelectorAll<HTMLElement>(".count");
  if (!reduced && "IntersectionObserver" in window) {
    nums.forEach((n) => (n.textContent = (0).toFixed(+n.dataset.dec!)));
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          const n = e.target as HTMLElement;
          const to = +n.dataset.to!, dec = +n.dataset.dec!, t0 = performance.now();
          const step = (t: number) => {
            const p = Math.min(1, (t - t0) / 1100);
            const v = to * (1 - Math.pow(1 - p, 3));
            n.textContent = v.toFixed(dec);
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }),
      { threshold: 0.4 }
    );
    nums.forEach((n) => io.observe(n));
  }
</script>
