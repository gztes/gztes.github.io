---
import { siteConfig } from "../config";
const s = siteConfig.social;
const links = [
  s?.email && { href: `mailto:${s.email}`, label: "Email" },
  s?.linkedin && { href: s.linkedin, label: "LinkedIn" },
  s?.github && { href: s.github, label: "GitHub" },
  s?.twitter && { href: s.twitter, label: "X" },
].filter(Boolean) as { href: string; label: string }[];
---

<div
  id="hero"
  class="bg-white px-8 sm:px-12 md:px-16 lg:px-24 pt-24 pb-16 md:pt-32 md:pb-24"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <p class="font-mono text-sm tracking-wide text-gray-500 rise">
        {siteConfig.kicker}
      </p>
      <h1
        class="mt-5 text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-semibold tracking-tight text-gray-900 leading-[0.95] rise d1"
      >
        {siteConfig.name}
      </h1>
      <p class="mt-6 max-w-xl text-xl sm:text-2xl text-gray-600 leading-snug rise d2">
        {siteConfig.title}
      </p>
      <div class="mt-10 flex flex-wrap gap-3 rise d3">
        {
          links.map((l, i) => (
            <a
              href={l.href}
              target={l.href.startsWith("mailto") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class={`px-5 py-2.5 rounded-full text-sm font-medium border transition-colors duration-200 ${
                i === 0
                  ? "text-white border-transparent hover:opacity-90"
                  : "text-gray-800 border-gray-300 hover:border-gray-900"
              }`}
              style={i === 0 ? `background-color: ${siteConfig.accentColor}` : ""}
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
    <figure class="lg:col-span-5 order-1 lg:order-2 rise d1">
      <img
        src={siteConfig.photo.src}
        alt={siteConfig.photo.alt}
        width="960"
        height="1200"
        class="w-full max-w-sm lg:max-w-none mx-auto aspect-[4/5] object-cover rounded-3xl"
        fetchpriority="high"
      />
      <figcaption class="mt-3 font-mono text-xs text-gray-500 text-center lg:text-left">
        {siteConfig.photo.caption}
      </figcaption>
    </figure>
  </div>
</div>

<style>
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .rise { animation: rise 0.7s ease-out both; }
  .d1 { animation-delay: 0.1s; }
  .d2 { animation-delay: 0.2s; }
  .d3 { animation-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
  }
</style>
