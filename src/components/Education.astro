---
import { siteConfig } from "../config";
const items = siteConfig.education ?? [];
---

{
  items.length > 0 && (
    <section id="education" class="px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="reveal">
        <p class="font-mono text-sm accent">Education</p>
        <h2 class="mt-2 text-4xl sm:text-5xl xl:text-6xl font-semibold tracking-tight text-gray-900">
          Three schools, three cities
        </h2>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        {items.map((e) => (
          <article class="group rounded-3xl border border-gray-200 bg-white overflow-hidden reveal">
            {e.image && (
              <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                <img
                  src={e.image}
                  alt={e.imageAlt ?? e.school}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                />
              </div>
            )}
            <div class="p-6">
              <p class="font-mono text-xs text-gray-500">{e.dateRange}</p>
              <h3 class="mt-2 text-lg font-semibold text-gray-900 leading-snug">{e.degree}</h3>
              <p class="mt-1 accent">{e.school}</p>
              <p class="mt-3 text-sm text-gray-600">{e.achievements.join(" · ")}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
