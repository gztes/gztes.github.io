---
import { siteConfig } from "../config";
const items = siteConfig.experience ?? [];
---

{
  items.length > 0 && (
    <section id="experience" class="px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28 bg-gray-50/70 border-y border-gray-100">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4 reveal">
          <p class="font-mono text-sm accent">Experience</p>
          <h2 class="mt-2 text-4xl sm:text-5xl xl:text-6xl font-semibold tracking-tight text-gray-900">
            Where I've worked
          </h2>
          <p class="mt-4 text-gray-500">Click a role to open it.</p>
        </div>
        <ol class="lg:col-span-8 relative border-l border-gray-200 ml-2">
          {items.map((e, i) => (
            <li class="pl-8 pb-2 relative reveal">
              <span class="absolute -left-[7px] top-[1.65rem] w-3.5 h-3.5 rounded-full border-2 border-white ring-1 ring-gray-300 dot" />
              <details class="group rounded-2xl hover:bg-white open:bg-white open:shadow-sm open:ring-1 open:ring-gray-200 transition-colors" open={i === 0}>
                <summary class="list-none cursor-pointer p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6">
                  <span class="font-mono text-xs sm:text-sm text-gray-500 sm:w-40 shrink-0">{e.dateRange}</span>
                  <span class="flex-1">
                    <span class="block text-lg font-semibold text-gray-900">{e.title}</span>
                    <span class="block text-gray-600">{e.company}</span>
                  </span>
                  <span class="hidden sm:grid w-8 h-8 place-items-center rounded-full border border-gray-300 text-gray-600 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <ul class="px-4 sm:px-5 pb-5 sm:pl-[13.5rem] space-y-2">
                  {e.bullets.map((b) => (
                    <li class="flex gap-3 text-gray-600">
                      <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-gray-400 shrink-0" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .dot { background: var(--accent); }
  summary::-webkit-details-marker { display: none; }
</style>
