---
import { siteConfig } from "../config";
const s = siteConfig.social;
const links = [
  s?.linkedin && { href: s.linkedin, label: "LinkedIn" },
  s?.github && { href: s.github, label: "GitHub" },
  s?.twitter && { href: s.twitter, label: "X" },
].filter(Boolean) as { href: string; label: string }[];
---

<section
  id="hero"
  class="relative px-6 sm:px-12 md:px-16 lg:px-24 pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <p class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm tracking-wide text-gray-500 rise">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        {siteConfig.kicker} · open to roles
      </p>
      <h1
        class="mt-5 text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-semibold tracking-tight text-gray-900 leading-[0.95] rise d1"
      >
        {siteConfig.name}
      </h1>
      <p class="mt-6 max-w-xl text-xl sm:text-2xl text-gray-600 leading-snug rise d2">
        {siteConfig.title}
      </p>
      <p class="mt-4 text-lg sm:text-xl text-gray-900 rise d2" aria-live="polite">
        Right now I build
        <span class="relative inline-block align-bottom overflow-hidden h-[1.4em]">
          <span id="role" class="inline-block font-semibold accent transition-all duration-300"
            >{siteConfig.roles[0]}</span
          ><span class="caret accent">|</span>
        </span>
      </p>
      <div class="mt-10 flex flex-wrap gap-3 rise d3">
        <a
          href="#contact"
          class="px-5 py-2.5 rounded-full text-sm font-medium text-white accent-bg hover:opacity-90 transition-opacity"
          >Get in touch</a
        >
        {
          links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full text-sm font-medium border text-gray-800 border-gray-300 hover:border-gray-900 transition-colors"
            >
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
    <figure class="lg:col-span-5 order-1 lg:order-2 rise d1">
      <div id="tilt" class="relative max-w-sm lg:max-w-none mx-auto will-change-transform transition-transform duration-200 ease-out">
        <img
          src={siteConfig.photo.src}
          alt={siteConfig.photo.alt}
          width="960"
          height="1200"
          class="w-full aspect-[4/5] object-cover rounded-3xl shadow-2xl shadow-blue-900/20"
          fetchpriority="high"
        />
        <div id="glare" class="pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-300"></div>
      </div>
      <figcaption class="mt-4 font-mono text-xs text-gray-500 text-center lg:text-left">
        {siteConfig.photo.caption}
      </figcaption>
    </figure>
  </div>
</section>

<script define:vars={{ roles: siteConfig.roles }}>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const el = document.getElementById("role");
  let i = 0;
  if (el && !reduced) {
    setInterval(() => {
      el.style.transform = "translateY(-100%)";
      el.style.opacity = "0";
      setTimeout(() => {
        i = (i + 1) % roles.length;
        el.textContent = roles[i];
        el.style.transition = "none";
        el.style.transform = "translateY(100%)";
        requestAnimationFrame(() => {
          el.style.transition = "";
          el.style.transform = "";
          el.style.opacity = "1";
        });
      }, 300);
    }, 2200);
  }
  const tilt = document.getElementById("tilt");
  const glare = document.getElementById("glare");
  if (tilt && !reduced && matchMedia("(hover: hover)").matches) {
    tilt.addEventListener("pointermove", (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `perspective(900px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.02)`;
      glare.style.opacity = "1";
      glare.style.background = `radial-gradient(circle at ${(x + 0.5) * 100}% ${(y + 0.5) * 100}%, rgba(255,255,255,.25), transparent 55%)`;
    });
    tilt.addEventListener("pointerleave", () => {
      tilt.style.transform = "";
      glare.style.opacity = "0";
    });
  }
</script>

<style>
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .rise { animation: rise 0.7s ease-out both; }
  .d1 { animation-delay: 0.1s; }
  .d2 { animation-delay: 0.2s; }
  .d3 { animation-delay: 0.3s; }
  @keyframes blink { 50% { opacity: 0; } }
  .caret { animation: blink 1s steps(1) infinite; margin-left: 2px; font-weight: 300; }
  @keyframes ping { 75%, 100% { transform: scale(2); opacity: 0; } }
  .ping { animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @media (prefers-reduced-motion: reduce) {
    .rise, .caret, .ping { animation: none; }
  }
</style>
